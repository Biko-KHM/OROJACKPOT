# -----------------------------------------------------------------------------
# HIREE Lottery API Backend - Production Environment Variables Template
# Deploy Target: Render Web Service & Supabase PostgreSQL
# -----------------------------------------------------------------------------

NODE_ENV=production
PORT=10000

# CORS Allowed Origins (Comma-separated list including your Vercel URL and Telegram Web)
CORS_ORIGIN=https://hiree-lottery-web.vercel.app,https://web.telegram.org

# Supabase PostgreSQL Database URLs
# 1. DATABASE_URL: Transaction Mode Pooler (Port 6543) with ?pgbouncer=true
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. DIRECT_URL: Direct Session Mode Connection (Port 5432) for Prisma Migrations & Schema Push
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Cryptographic Session & JWT Keys (Generate with: openssl rand -hex 32)
JWT_SECRET=replace_with_64_character_random_hex_string_111111111111111111111111
ADMIN_SESSION_SECRET=replace_with_64_character_random_hex_string_222222222222222222222222
TOTP_ENCRYPTION_KEY=replace_with_32_character_random_string_333333333333333333333333

# Supabase Storage Integration (For Campaign Prize Images)
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
SUPABASE_STORAGE_BUCKET=campaign-images

# Telegram Bot Integration (Obtained from @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_WEBHOOK_SECRET=replace_with_random_hex_string_for_webhook_security
# Note: TELEGRAM_CHANNEL_ID is NOT required here; it is configured and wired directly in the Superadmin Portal Settings!
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400

# Distributed Redis URL (Optional - e.g. Upstash Redis / Render Redis)
# If omitted, system automatically falls back to high-performance zero-downtime In-Memory Cache
REDIS_URL=rediss://default:password@your-endpoint.upstash.io:6379

# Initial Superadmin Account Setup (used during initial npm run prisma:seed)
INITIAL_SUPERADMIN_EMAIL=admin@lottery.et
INITIAL_SUPERADMIN_PASSWORD=ChangeMe@Admin2026!
INITIAL_SUPERADMIN_TG_ID=123456789
SEED_SAMPLE_DATA=false
