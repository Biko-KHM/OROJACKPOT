# Application Configuration
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/telegram_lottery?schema=public

# Object Storage (MinIO / S3 compatible)
S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=payment-evidence
S3_REGION=us-east-1

# Authentication & Security
JWT_SECRET=development_jwt_secret_must_be_at_least_32_chars_long
ADMIN_SESSION_SECRET=development_admin_session_secret_at_least_32_chars
TOTP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Telegram Integration
TELEGRAM_BOT_TOKEN=dummy_telegram_bot_token_for_dev
TELEGRAM_WEBHOOK_SECRET=dummy_webhook_secret_for_dev
TELEGRAM_CHANNEL_ID=

# Superadmin Configuration
# Set your numeric Telegram user ID on Render backend (and optionally on Vercel frontend)
INITIAL_SUPERADMIN_TG_ID=
VITE_SUPERADMIN_TELEGRAM_ID=
INITIAL_SUPERADMIN_EMAIL=admin@lottery.et
INITIAL_SUPERADMIN_PASSWORD=Admin@123456
